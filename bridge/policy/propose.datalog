// The Bridge's policy for a proposed signal (4.1.1, docs/dev/THREAT-MODEL.md). The connector's Biscuit says, in its
// authority block, which game, sources, signals and players it may speak for, for which audience; its attenuation
// blocks may only add checks (an expiry, fewer players). The Bridge adds the request and the time, then this policy.
// Parameters, bound by bridge/src/policy.ts: {now} {game} {player} {source} {signal} {audience}.
time({now});
request_game({game});
request_player({player});
request_source({source});
request_signal({signal});
request_audience({audience});

allow if request_game($g), game($g), request_source($s), source($s), request_signal($x), signal($x),
  request_audience($a), audience($a), request_player($p), player($p);
allow if request_game($g), game($g), request_source($s), source($s), request_signal($x), signal($x),
  request_audience($a), audience($a), any_player(true);
