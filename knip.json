{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/studio/main.ts",
    "src/engine/api/*.ts",
    "src/engine/tools/solve-worker.ts",
    "bridge/bin.mjs",
    "bridge/src/cli.ts",
    "cli/*.mjs",
    "scripts/*.mjs",
    "scripts/*.ts",
    "tools/*.ts",
    "tools/studio/*.ts",
    "tests/**/*.test.ts",
    "tests/fixtures/**/index.ts",
    "games/*/index.ts",
    "games/*/e2e.mjs",
    "games/_template/**/*.ts",
    "vitest.mutation.config.ts",
    "src/engine/boot.ts"
  ],
  "project": [
    "src/**/*.ts",
    "bridge/src/**/*.ts",
    "cli/**/*.mjs",
    "scripts/**",
    "tools/**/*.ts",
    "tests/**/*.ts",
    "games/**/*.ts"
  ],
  "ignore": [
    "games/*/ending.config.example.ts"
  ],
  "ignoreDependencies": [
    "@tweakpane/core"
  ],
  "ignoreBinaries": [
    "ffmpeg",
    "ffprobe"
  ],
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "unresolved": "error",
    "duplicates": "error",
    "exports": "off",
    "types": "off",
    "nsExports": "off",
    "nsTypes": "off",
    "enumMembers": "off"
  },
  "ignoreUnresolved": [
    "5"
  ]
}
