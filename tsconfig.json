{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "web-scumm/*": [
        "src/engine/api/*"
      ],
      "@engine/*": [
        "src/engine/*"
      ],
      "@game": [
        ".cache/game/index.ts",
        "games/demo/index.ts"
      ],
      "@game/*": [
        ".cache/game/*",
        "games/demo/*"
      ]
    },
    "types": [
      "vite/client",
      "node"
    ]
  },
  "include": [
    "src",
    "games",
    "tests",
    "tools",
    "scripts",
    "bridge"
  ],
  "exclude": [
    "legacy",
    "node_modules",
    "dist"
  ]
}
