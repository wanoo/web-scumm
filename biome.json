{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**/*.ts",
      "tools/**/*.ts",
      "tools/**/*.mjs",
      "tests/**/*.ts",
      "scripts/**/*.mjs",
      "scripts/**/*.ts",
      "games/**/*.ts",
      "cli/**/*.mjs",
      "vite.config.ts",
      "vitest.config.ts",
      "!legacy",
      "!dist",
      "!public",
      "!.cache",
      "!tools/audio/.venv",
      "!tools/audio/.furnace"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "includes": ["**", "!games/**"]
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": false
    }
  }
}
