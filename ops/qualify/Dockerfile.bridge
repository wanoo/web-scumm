# The reference Bridge's image for the qualification profile (4.1.18, ops/qualify/README.md): built from the
# candidate's `web-scumm-bridge` tarball (never from this checkout), its production dependencies and the Postgres peer.
FROM mirror.gcr.io/library/node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392
COPY web-scumm-bridge.tgz /tmp/web-scumm-bridge.tgz
RUN mkdir -p /opt/bridge \
 && tar -xzf /tmp/web-scumm-bridge.tgz -C /opt/bridge --strip-components=1 \
 && cd /opt/bridge \
 && npm install --omit=dev --no-audit --no-fund \
 && npm install --no-save --no-audit --no-fund "pg@^8.23.1" \
 && rm /tmp/web-scumm-bridge.tgz \
 && npm cache clean --force
WORKDIR /opt/bridge
ENTRYPOINT ["node", "/opt/bridge/bin.mjs"]
