# The qualification profile's HTTPS front (4.1.18): a local CA (`tls internal`, its root read from the proxy's data
# volume by ops:qualify), every request spread over the three Bridges with health checks, and one port per instance
# so the qualification can reach a given one (a stream on one, proposals on another). A real deployment puts its own
# certificate here (ops/qualify/README.md).
{
	local_certs
	skip_install_trust
	admin off
}

https://localhost:8443 {
	reverse_proxy bridge-1:8787 bridge-2:8787 bridge-3:8787 {
		lb_policy round_robin
		lb_retries 2
		health_uri /readyz
		health_interval 2s
		fail_duration 10s
		flush_interval -1
	}
}
https://localhost:8444 {
	reverse_proxy bridge-1:8787 {
		flush_interval -1
	}
}
https://localhost:8445 {
	reverse_proxy bridge-2:8787 {
		flush_interval -1
	}
}
https://localhost:8446 {
	reverse_proxy bridge-3:8787 {
		flush_interval -1
	}
}
