{
  "name": "web-scumm",
  "private": true,
  "version": "3.3.1",
  "type": "module",
  "scripts": {
    "dev": "tsx tools/select-game.ts && vite",
    "dev:lan": "tsx tools/select-game.ts && tsx tools/serve.ts --lan",
    "studio": "tsx tools/select-game.ts && STUDIO=1 vite --open /__studio/",
    "studio:lan": "tsx tools/select-game.ts && tsx tools/serve.ts --lan --studio",
    "build": "npm run check && npm run test:assets && npm run verify:game && vite build && npm run check:spoilers && npm run audit:assets",
    "preview": "vite preview --host 127.0.0.1",
    "start": "sirv dist --host 0.0.0.0 --port ${PORT:-8080} --maxage 3600",
    "test": "npm run test:node",
    "test:node": "vitest run --exclude tests/pixel.test.ts --exclude tests/studio-assets.test.ts",
    "test:assets": "vitest run tests/pixel.test.ts tests/studio-assets.test.ts",
    "doctor": "tsx tools/doctor.ts",
    "check": "tsx tools/select-game.ts && tsc --noEmit && npm run test:node",
    "verify:game": "npm run validate && npm run solve && npm run solve -- --chapters && npm run i18n -- status && npm run lint && npm run playtests",
    "prove:game": "npm run solve -- --prove && npm run solve -- --prove --chapters",
    "e2e:smoke": "node scripts/e2e.mjs --generic --prod",
    "e2e:pwa": "node scripts/e2e-pwa.mjs",
    "e2e:weight": "node scripts/e2e-weight.mjs",
    "e2e:visual": "node scripts/e2e-visual.mjs",
    "release-check": "npm run doctor && npm run build && npm run verify:release && npm run prove:game && npm run solve -- --audit-abstractions && npm run audit:deps && npm audit --audit-level=high",
    "e2e": "node scripts/e2e.mjs",
    "validate": "tsx tools/validate.ts",
    "solve": "tsx tools/solve.ts",
    "replay": "tsx tools/replay.ts",
    "ids": "tsx tools/ids.ts",
    "playtests": "tsx tools/playtests.ts",
    "lint": "tsx tools/lint.ts",
    "mcp": "tsx tools/mcp/server.ts",
    "assets": "mkdir -p .cache && tsx --tsconfig tsconfig.json tools/refs.ts > .cache/refs.json && python3 tools/assets.py",
    "game": "tsx tools/select-game.ts",
    "seal": "tsx scripts/seal.ts",
    "check:spoilers": "tsx scripts/check-spoilers.ts",
    "icons": "node scripts/gen-icons.mjs",
    "audit": "npm run audit:assets",
    "audit:assets": "tsx tools/audit-assets.ts",
    "audit:deps": "npm audit --omit=dev",
    "prompts": "tsx --tsconfig tsconfig.json tools/prompts.ts",
    "audio": "python3 tools/audio.py",
    "build:web": "vite build",
    "build:studio-demo": "tsx tools/select-game.ts && STUDIO=1 VITE_STUDIO_DEMO=1 vite build",
    "studio-snapshot": "tsx tools/studio/snapshot.ts",
    "studio-apply": "tsx tools/studio/apply.ts",
    "new-game": "node scripts/new-game.mjs",
    "page:storyboard": "tsx --tsconfig tsconfig.json tools/pages/storyboard.ts",
    "page:review": "tsx --tsconfig tsconfig.json tools/pages/review.ts",
    "page:placement": "tsx --tsconfig tsconfig.json tools/pages/placement.ts",
    "page:world": "tsx --tsconfig tsconfig.json tools/pages/world.ts",
    "page:puzzles": "tsx --tsconfig tsconfig.json tools/pages/puzzles.ts",
    "i18n": "tsx --tsconfig tsconfig.json tools/i18n.ts",
    "bench": "tsx --tsconfig tsconfig.json tools/bench.ts",
    "import-layout": "tsx --tsconfig tsconfig.json tools/pages/import-layout.ts",
    "verify:release": "npm run validate -- --release && npm run weight -- --release && npm run i18n -- status && npm run playtests -- --strict",
    "verify:commercial": "npm run verify:release && npm run validate -- --commercial --errors",
    "provenance": "tsx tools/provenance.ts",
    "weight": "tsx tools/weight.ts",
    "e2e:a11y": "node scripts/e2e-a11y.mjs",
    "docs:screenshots": "node scripts/docs-screenshots.mjs"
  },
  "config": {
    "game": "demo"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@tweakpane/core": "^2.0.5",
    "@types/howler": "^2.2.13",
    "@types/node": "^22.10.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "playwright": "^1.63.0",
    "tsx": "^4.19.0",
    "tweakpane": "^4.0.5",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "earcut": "^3.2.3",
    "howler": "^2.2.4",
    "navmesh": "^2.3.1",
    "sirv-cli": "^3.0.1",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=22"
  },
  "description": "Mobile-first SCUMM-style point-and-click engine with authoring tools and an AI-friendly workflow",
  "license": "MIT"
}
